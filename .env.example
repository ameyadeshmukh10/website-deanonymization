# =============================================================================
# Website Deanonymization Pipeline — environment variables
# =============================================================================
# Copy to `.env` and fill in the blanks. `.env` is gitignored.

# --- Cloudflare Worker (Step 1B) ---------------------------------------------
# Base URL of the deployed Worker (no trailing slash).
WORKER_BASE_URL=

# Bearer token required by /export. Same value you pasted into
# `wrangler secret put ADMIN_TOKEN`.
WORKER_ADMIN_TOKEN=

# --- People Data Labs (Step 3) -----------------------------------------------
# https://dashboard.peopledatalabs.com
PDL_API_KEY=

# --- HubSpot (Steps 4 & 7) ---------------------------------------------------
# Private App access token with scopes:
#   crm.objects.companies.read, crm.objects.companies.write
#   crm.schemas.companies.read
#   crm.objects.contacts.read,  crm.objects.contacts.write   (Step 7)
HUBSPOT_API_KEY=

# Optional: contact property to use as the LinkedIn-URL match key when
# PDL's work_email is masked by your plan. Defaults to `linkedin_url`.
# HubSpot's built-in is `hs_linkedin_url` — recommended if your portal has it.
# HUBSPOT_LINKEDIN_PROPERTY=hs_linkedin_url

# --- Slack notifications (Round 3) -------------------------------------------
# Incoming webhook URL for instant alerts + daily digest. Create one at
# https://api.slack.com/apps → "Incoming Webhooks". Leave blank to suppress
# Slack posts (notify.py logs what it would have sent and exits cleanly).
# SLACK_WEBHOOK_URL=

# Optional: HubSpot portal id (visible in app.hubspot.com URL). When set,
# notify.py adds clickable "Open in HubSpot" links to each Slack message.
# HUBSPOT_PORTAL_ID=
